{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoEditor Desktop",
  "version": "0.1.0",
  "identifier": "net.coeditor.lite.desktop",
  "build": {
    "beforeDevCommand": "bash ../scripts/dev.sh",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bash ../build-desktop.sh",
    "frontendDist": "../../packages/client/dist-h5"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": ["binaries/coeditor-server"],
    "resources": {
      "../../data/prompts": "seed-data/prompts",
      "../../data/templates": "seed-data/templates",
      "../../packages/client/dist-h5": "dist-h5"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
